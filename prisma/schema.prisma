generator client {
  provider      = "prisma-client"
  output        = "../generated/prisma"
  binaryTargets = ["native"]
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../generated/zod"
  createInputTypes                 = false
  createOptionalDefaultValuesTypes = true
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Lifecycle position only. Whether a project wants an owner or more help is not a
// status: `isSeekingOwner` is derived (see lib/project-status.ts) and `isSeekingHelp`
// is an independent flag the owner controls.
//   draft → pending_review → needs_discussion → ready → in_progress → on_hold → completed → archived
// `ready` = approved and live, but nobody owns it yet.
// `draft` = org-proposed only, admin still preparing it; never enters the review queue.
enum ProjectStatus {
  draft
  pending_review
  needs_discussion
  ready
  in_progress
  on_hold
  completed
  archived
}

enum WorkItemType {
  PROJECT
  TASK
  QUICK_TASK
}

enum TemplateSourceType {
  PROJECT
  QUICK_TASK
}

enum RemoteEligibility {
  NONE
  COUNTRY
  GLOBAL
}

enum TaskStatus {
  open
  in_progress
  under_review
  completed
}

enum DailySummaryPreference {
  email_and_in_app
  in_app_only
  off
}

/// How a task's dates are read: any time within the window, or on exactly those dates.
enum TaskTiming {
  flexible
  fixed
}

enum QuickTaskStatus {
  open
  in_progress
  under_review
  completed
}

enum InterestStatus {
  pending
  accepted
  // An applicant the owner turned down.
  declined
  withdrawn
  // A helper the owner took off the project after they were on it.
  removed
  // Asked by the owner or an admin; not on the project until they accept.
  invited
  // An invite the owner or an admin took back before it was answered.
  cancelled
}

/// How someone came to be on a project's interest list.
enum InterestOrigin {
  applied
  // Put on the project by an admin, with no say.
  added
  invited
}

enum ApprovalStatus {
  pending
  under_review
  needs_info
  approved
  rejected
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum LocalGroupSuggestionStatus {
  pending
  accepted
  merged
  on_hold
  declined
}

model AdminInvite {
  id           Int          @id @default(autoincrement())
  /// @zod.string.email({ message: "A valid email address is required" })
  email        String
  /// @zod.custom.omit([model])
  inviteToken  String       @unique @map("invite_token")
  invitedById  Int          @map("invited_by_id")
  status       InviteStatus @default(pending)
  acceptedById Int?         @map("accepted_by_id")
  acceptedAt   DateTime?    @map("accepted_at")
  expiresAt    DateTime     @map("expires_at")
  createdAt    DateTime?    @default(now()) @map("created_at")
  acceptedBy   Volunteer?   @relation("AdminInviteAcceptedBy", fields: [acceptedById], references: [id], onUpdate: NoAction)
  invitedBy    Volunteer    @relation("AdminInviteInvitedBy", fields: [invitedById], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([inviteToken], map: "idx_admin_invites_token")
  @@index([email], map: "idx_admin_invites_email")
  @@map("admin_invites")
}

model AdminNote {
  id                Int       @id @default(autoincrement())
  volunteerId       Int       @map("volunteer_id")
  authorId          Int       @map("author_id")
  /// @zod.string.min(1, { message: "Content is required" })
  content           String
  category          String?   @default("general") // TODO: enum — general (others unknown)
  relatedWorkItemId Int?      @map("related_work_item_id")
  createdAt         DateTime? @default(now()) @map("created_at")
  updatedAt         DateTime? @default(now()) @map("updated_at")
  relatedWorkItem   WorkItem? @relation(fields: [relatedWorkItemId], references: [id], onUpdate: NoAction)
  author            Volunteer @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  volunteer         Volunteer @relation("AdminNoteVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId], map: "idx_admin_notes_volunteer")
  @@map("admin_notes")
}

model BugReport {
  id              Int                @id @default(autoincrement())
  reporterId      Int?               @map("reporter_id")
  reporterEmail   String?            @map("reporter_email")
  /// @zod.string.min(1, { message: "Title is required" }).max(300, { message: "Title must be 300 characters or fewer" })
  title           String
  /// @zod.string.min(10, { message: "Description must be at least 10 characters" })
  description     String
  pageUrl         String?            @map("page_url")
  category        String?            @default("bug") // TODO: enum — bug, feature, ui (others unknown)
  severity        String?            @default("medium") // TODO: enum — low, medium, high, critical
  status          String             @default("open") // TODO: enum — open, in_progress, resolved, closed
  resolutionNotes String?            @map("resolution_notes")
  resolvedById    Int?               @map("resolved_by_id")
  resolvedAt      DateTime?          @map("resolved_at")
  assigneeId      Int?               @map("assignee_id")
  createdAt       DateTime?          @default(now()) @map("created_at")
  resolvedBy      Volunteer?         @relation("BugReportResolvedBy", fields: [resolvedById], references: [id], onUpdate: NoAction)
  reporter        Volunteer?         @relation("BugReportReporter", fields: [reporterId], references: [id], onUpdate: NoAction)
  assignee        Volunteer?         @relation("BugReportAssignee", fields: [assigneeId], references: [id], onUpdate: NoAction)
  comments        BugReportComment[]

  @@index([reporterId], map: "idx_bug_reports_reporter")
  @@index([status], map: "idx_bug_reports_status")
  @@index([assigneeId], map: "idx_bug_reports_assignee")
  @@map("bug_reports")
}

model BugReportComment {
  id          Int       @id @default(autoincrement())
  bugReportId Int       @map("bug_report_id")
  authorId    Int       @map("author_id")
  /// @zod.string.min(1, { message: "Content is required" })
  content     String
  createdAt   DateTime? @default(now()) @map("created_at")
  editedAt    DateTime? @map("edited_at")
  /// Soft delete: the row stays so the thread keeps its shape; the content is never served.
  deletedAt   DateTime? @map("deleted_at")
  author      Volunteer @relation("BugReportCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bugReport   BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bugReportId, createdAt], map: "idx_bug_report_comments_thread")
  @@map("bug_report_comments")
}

model Message {
  id                Int       @id @default(autoincrement())
  fromVolunteerId   Int       @map("from_volunteer_id")
  toVolunteerId     Int       @map("to_volunteer_id")
  subject           String
  message           String
  relatedWorkItemId Int?      @map("related_work_item_id")
  readAt            DateTime? @map("read_at")
  createdAt         DateTime? @default(now()) @map("created_at")
  /// The conversation's first message; null on that first message itself.
  threadId          Int?      @map("thread_id")
  relatedWorkItem   WorkItem? @relation(fields: [relatedWorkItemId], references: [id], onUpdate: NoAction)
  to                Volunteer @relation("MessageTo", fields: [toVolunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  from              Volunteer @relation("MessageFrom", fields: [fromVolunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  thread            Message?  @relation("MessageThread", fields: [threadId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies           Message[] @relation("MessageThread")

  @@index([threadId], map: "idx_contact_messages_thread")
  @@index([fromVolunteerId], map: "idx_contact_messages_from")
  @@index([toVolunteerId], map: "idx_contact_messages_to")
  @@map("contact_messages")
}

model DeletionRequest {
  id             Int       @id @default(autoincrement())
  volunteerId    Int       @map("volunteer_id")
  volunteerEmail String?   @map("volunteer_email")
  status         String    @default("pending") // TODO: enum — pending, completed
  requestedAt    DateTime? @default(now()) @map("requested_at")
  completedAt    DateTime? @map("completed_at")

  @@map("deletion_requests")
}

model Notification {
  id          Int       @id @default(autoincrement())
  volunteerId Int       @map("volunteer_id")
  type        String // TODO: enum — new_project_proposal, project_approved, project_needs_discussion, project_status_changed, new_interest, interest_accepted, interest_declined, interest_withdrawn, assigned_to_project, task_assigned, new_bug_report, quick_task_assigned, quick_task_submitted, quick_task_reviewed, local_group_suggestion
  title       String
  body        String?
  link        String?
  // Identifies the resource this notification is about (e.g. a project or bug report id), so
  // that when the underlying item is resolved by one person, matching notifications for the
  // same (type, entityId) can be cleared for every other recipient. Null for types that aren't
  // cleared this way.
  entityId    Int?      @map("entity_id")
  readAt      DateTime? @map("read_at")
  emailedAt   DateTime? @map("emailed_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId, readAt], map: "idx_notifications_unread")
  @@index([volunteerId], map: "idx_notifications_volunteer")
  @@index([type, entityId], map: "idx_notifications_type_entity")
  @@map("notifications")
}

model PasswordResetToken {
  id          Int       @id @default(autoincrement())
  volunteerId Int       @map("volunteer_id")
  /// @zod.custom.omit([model])
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId], map: "idx_password_reset_tokens_volunteer")
  @@index([token], map: "idx_password_reset_tokens_token")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          Int       @id @default(autoincrement())
  volunteerId Int       @map("volunteer_id")
  /// @zod.custom.omit([model])
  token       String    @unique
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime? @default(now()) @map("created_at")
  volunteer   Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([volunteerId], map: "idx_email_verification_tokens_volunteer")
  @@index([token], map: "idx_email_verification_tokens_token")
  @@map("email_verification_tokens")
}

model WorkItem {
  id          Int       @id @default(autoincrement())
  type        String // PROJECT | TASK | QUICK_TASK
  status      String // type-specific, enforced at app layer
  /// @zod.string.min(1, { message: "Title is required" })
  title       String
  description String?
  deadline    DateTime? // applies to PROJECT, TASK, or QUICK_TASK

  // Hierarchy: TASK has parentId → PROJECT
  parentId Int?       @map("parent_id")
  parent   WorkItem?  @relation("WorkItemChildren", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children WorkItem[] @relation("WorkItemChildren")

  // Context: QUICK_TASK optionally references a PROJECT (not hierarchical)
  contextProjectId Int?       @map("context_project_id")
  contextProject   WorkItem?  @relation("WorkItemContext", fields: [contextProjectId], references: [id], onUpdate: NoAction)
  contextTasks     WorkItem[] @relation("WorkItemContext")

  // People roles
  creatorId     Int? @map("creator_id")
  assigneeId    Int? @map("assignee_id")
  // A task someone not yet on the project asked to take: held for them until the owner
  // answers their join request (TASK only).
  requestedById Int? @map("requested_by_id")
  stakeholderId Int? @map("stakeholder_id")

  // Review
  reviewedById Int?      @map("reviewed_by_id")
  reviewedAt   DateTime? @map("reviewed_at")
  reviewNotes  String?   @map("review_notes")
  reviewRating String?   @map("review_rating") // QUICK_TASK only

  // Submitted work (TASK and QUICK_TASK): what the assignee says they did, at least one of
  // the two. `changesRequestedNote` is the reviewer's latest "ask for changes", shown to the
  // assignee until they submit again; `reviewedById`/`reviewedAt` above record who asked.
  submissionNote       String?   @map("submission_note")
  submissionUrl        String?   @map("submission_url")
  submittedAt          DateTime? @map("submitted_at")
  changesRequestedNote String?   @map("changes_requested_note")

  // Project-specific (nullable for TASK/QUICK_TASK)
  projectType                String?   @map("project_type") // TODO: enum — sprint, container, ongoing, one_off
  urgency                    String?   @default("medium") // TODO: enum — low, medium, high
  estimatedDuration          String?   @map("estimated_duration")
  timeCommitmentHoursPerWeek Int?      @map("time_commitment_hours_per_week")
  collaborationLink          String?   @map("collaboration_link")
  isOrgProposed              Boolean?  @default(false) @map("is_org_proposed")
  // No `is_seeking_owner` column: it is derived from (status, assigneeId). See
  // isSeekingOwner() in lib/project-status.ts.
  isSeekingHelp              Boolean?  @default(false) @map("is_seeking_help")
  // Submitted tasks go straight to Done instead of waiting for the owner to accept them.
  autoAcceptTasks            Boolean   @default(true) @map("auto_accept_tasks")
  outcome                    String? // TODO: enum — successful, partial, not_completed, ongoing
  outcomeNotes               String?   @map("outcome_notes")
  completedAt                DateTime? @map("completed_at")

  // Task / quick-task-specific (nullable for PROJECT)
  skillId             Int?      @map("skill_id")
  estimatedHours      Float?    @map("estimated_hours")
  nudgeSentAt         DateTime? @map("nudge_sent_at")
  finalWarningSentAt  DateTime? @map("final_warning_sent_at")
  sortOrder           Int?      @default(0) @map("sort_order")
  featuredAsQuickTask Boolean?  @default(false) @map("featured_as_quick_task") // TASK only — also list on the Quick Tasks page

  // Scheduling — applies to PROJECT and TASK alike, so it is not in either type-specific
  // block above. QUICK_TASK does not participate. See lib/schedule.ts.
  // `startDate` null + predecessors => start is derived from them; set => pinned to that date.
  // `durationDays` null is read as 1 day; a PROJECT with none rolls its span up from its tasks.
  startDate            DateTime?  @map("start_date")
  durationDays         Int?       @map("duration_days")
  // The plan as committed. Captured the first time an item is scheduled, then moved only by an
  // explicit re-baseline — never by an ordinary edit or a dependency cascade.
  baselineStartDate    DateTime?  @map("baseline_start_date")
  baselineDurationDays Int?       @map("baseline_duration_days")
  baselineSetAt        DateTime?  @map("baseline_set_at")
  // The fixed point the plan is built around — a protest date, a launch, a hearing. The
  // critical path is measured towards anchors when any exist, rather than towards whatever
  // simply finishes last, so follow-up work trailing an anchor is correctly slack.
  isAnchor             Boolean    @default(false) @map("is_anchor")
  // `flexible`: the work happens any time within start..start+duration (effort may be far less).
  // `fixed`: it happens on exactly those dates — a shift, a stall, the event itself.
  timing               TaskTiming @default(flexible)
  // Last change to startDate/durationDays or to this item's dependency edges.
  scheduleUpdatedAt    DateTime?  @map("schedule_updated_at")
  // Actual start. `completedAt` above is the actual finish.
  startedAt            DateTime?  @map("started_at")

  country           String?
  localGroup        String?           @map("local_group")
  remoteEligibility RemoteEligibility @default(NONE) @map("remote_eligibility")
  // Optional standing team this PROJECT belongs to (Team is orthogonal to LocalGroup —
  // see Team model). Nullable, TASK/QUICK_TASK don't use it.
  teamId            Int?              @map("team_id")
  // Set only on a PROJECT created by instantiating a Template. Distinct from isOrgProposed:
  // gates the self-publish-without-triage path in publishDraft and the separate
  // MAX_TEMPLATE_DRAFTS cap, rather than the general volunteer draft pool.
  templateOriginId  Int?              @map("template_origin_id")
  createdAt         DateTime?         @default(now()) @map("created_at")
  updatedAt         DateTime?         @default(now()) @map("updated_at")

  creator              Volunteer?             @relation("WorkItemCreator", fields: [creatorId], references: [id], onUpdate: NoAction)
  templateOrigin       Template?              @relation("WorkItemTemplateOrigin", fields: [templateOriginId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  assignee             Volunteer?             @relation("WorkItemAssignee", fields: [assigneeId], references: [id], onUpdate: NoAction)
  requestedBy          Volunteer?             @relation("WorkItemRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: NoAction)
  stakeholder          Volunteer?             @relation("WorkItemStakeholder", fields: [stakeholderId], references: [id], onUpdate: NoAction)
  reviewedBy           Volunteer?             @relation("WorkItemReviewedBy", fields: [reviewedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  skill                Skill?                 @relation(fields: [skillId], references: [id], onUpdate: NoAction)
  team                 Team?                  @relation(fields: [teamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  comments             WorkItemComment[]
  finishByReminders    FinishByReminder[]
  reviewRequests       ProjectReviewRequest[]
  skills               WorkItemSkill[]
  interests            WorkItemInterest[]
  deputies             ProjectDeputy[]        @relation("ProjectDeputies")
  adminNotes           AdminNote[]
  messages             Message[]
  templatesSourcedFrom Template[]             @relation("TemplateSourceProject")

  dependenciesAsPredecessor WorkItemDependency[] @relation("WorkItemDependencyPredecessor")
  dependenciesAsSuccessor   WorkItemDependency[] @relation("WorkItemDependencySuccessor")

  @@index([type], map: "idx_work_items_type")
  @@index([status], map: "idx_work_items_status")
  @@index([parentId], map: "idx_work_items_parent")
  @@index([contextProjectId], map: "idx_work_items_context")
  @@index([creatorId], map: "idx_work_items_creator")
  @@index([assigneeId], map: "idx_work_items_assignee")
  @@index([skillId], map: "idx_work_items_skill")
  @@index([localGroup], map: "idx_work_items_local_group")
  @@index([country], map: "idx_work_items_country")
  @@index([teamId], map: "idx_work_items_team")
  @@index([templateOriginId], map: "idx_work_items_template_origin")
  @@map("work_items")
}

/// An admin's request for changes to a proposal. Open until the proposer resubmits it or an
/// admin approves; each round is kept.
model ProjectReviewRequest {
  id            Int        @id @default(autoincrement())
  projectId     Int        @map("project_id")
  message       String
  requestedById Int?       @map("requested_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  resolvedAt    DateTime?  @map("resolved_at")
  project       WorkItem   @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requestedBy   Volunteer? @relation(fields: [requestedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([projectId, createdAt], map: "idx_project_review_requests_project")
  @@map("project_review_requests")
}

model WorkItemComment {
  id         Int               @id @default(autoincrement())
  workItemId Int               @map("work_item_id")
  authorId   Int?              @map("author_id")
  /// @zod.string.min(1, { message: "Content is required" })
  content    String
  createdAt  DateTime?         @default(now()) @map("created_at")
  /// A reply's top-level comment; replies are never nested deeper.
  parentId   Int?              @map("parent_id")
  editedAt   DateTime?         @map("edited_at")
  /// Soft delete: the row stays so its replies keep their place; the content is never served.
  deletedAt  DateTime?         @map("deleted_at")
  author     Volunteer?        @relation("WorkItemCommentAuthor", fields: [authorId], references: [id], onUpdate: NoAction)
  workItem   WorkItem          @relation(fields: [workItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     WorkItemComment?  @relation("WorkItemCommentReplies", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies    WorkItemComment[] @relation("WorkItemCommentReplies")

  @@index([workItemId, createdAt], map: "idx_work_item_comments_thread")
  @@index([parentId], map: "idx_work_item_comments_parent")
  @@map("work_item_comments")
}

/// Finish-to-start dependency between two WorkItems in the same scheduling scope — that is,
/// sharing both `type` and `parentId`. That one rule yields exactly the two graphs we want:
/// TASKs within a single project, and PROJECTs across the portfolio. QUICK_TASK is excluded.
/// The successor starts at predecessor end + 1 day + `lagDays` (negative lag = overlap).
model WorkItemDependency {
  id            Int       @id @default(autoincrement())
  predecessorId Int       @map("predecessor_id")
  successorId   Int       @map("successor_id")
  lagDays       Int       @default(0) @map("lag_days")
  createdAt     DateTime? @default(now()) @map("created_at")
  createdById   Int?      @map("created_by_id")

  predecessor WorkItem   @relation("WorkItemDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  successor   WorkItem   @relation("WorkItemDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdBy   Volunteer? @relation("WorkItemDependencyCreator", fields: [createdById], references: [id], onUpdate: NoAction)

  @@unique([predecessorId, successorId], map: "uq_work_item_dependencies_pair")
  @@index([successorId], map: "idx_work_item_dependencies_successor")
  @@map("work_item_dependencies")
}

model WorkItemSkill {
  workItemId Int       @map("work_item_id")
  skillId    Int       @map("skill_id")
  isRequired Boolean?  @default(true) @map("is_required")
  createdAt  DateTime? @default(now()) @map("created_at")
  skill      Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workItem   WorkItem  @relation(fields: [workItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([workItemId, skillId])
  @@index([skillId], map: "idx_work_item_skills_skill")
  @@map("work_item_skills")
}

/// An accepted helper the owner has delegated a project's task management to. The row goes
/// when the person stops being an accepted helper.
model ProjectDeputy {
  id            Int        @id @default(autoincrement())
  projectId     Int        @map("project_id")
  volunteerId   Int        @map("volunteer_id")
  appointedById Int?       @map("appointed_by_id")
  createdAt     DateTime   @default(now()) @map("created_at")
  project       WorkItem   @relation("ProjectDeputies", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  volunteer     Volunteer  @relation("DeputyVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  appointedBy   Volunteer? @relation("DeputyAppointedBy", fields: [appointedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([projectId, volunteerId], map: "uq_project_deputies_project_volunteer")
  @@index([volunteerId], map: "idx_project_deputies_volunteer")
  @@map("project_deputies")
}

model WorkItemInterest {
  id              Int            @id @default(autoincrement())
  volunteerId     Int            @map("volunteer_id")
  workItemId      Int            @map("work_item_id")
  interestType    String         @map("interest_type") // TODO: enum — want_to_contribute, want_to_own
  /// The applicant's message, or the inviter's note on an invite.
  message         String?
  status          InterestStatus @default(pending)
  origin          InterestOrigin @default(applied)
  responseMessage String?        @map("response_message")
  createdAt       DateTime?      @default(now()) @map("created_at")
  respondedAt     DateTime?      @map("responded_at")
  invitedById     Int?           @map("invited_by_id")
  workItem        WorkItem       @relation(fields: [workItemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  volunteer       Volunteer      @relation("InterestVolunteer", fields: [volunteerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invitedBy       Volunteer?     @relation("InterestInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([volunteerId, workItemId], map: "uq_work_item_interests_volunteer_item")
  @@index([volunteerId], map: "idx_work_item_interests_volunteer")
  @@index([workItemId], map: "idx_work_item_interests_work_item")
  @@map("work_item_interests")
}

/// A reusable project shape an admin can spin up as a fresh draft project — for running the
/// same program across countries/local groups. `structure` is a serialized, location- and
/// people-free copy of a project's tasks/schedule/dependencies/skills (see
/// lib/template-porting.ts); country/localGroup/team are deliberately never stored here beyond
/// the display-only `source*` fields below, which exist purely so the instantiate wizard can
/// show "previously: X" next to the blanked picker — they are never read by instantiate itself.
model Template {
  id                    Int                @id @default(autoincrement())
  /// @zod.string.min(1, { message: "Title is required" })
  title                 String
  description           String?
  sourceType            TemplateSourceType @default(PROJECT) @map("source_type")
  // Bumped whenever the shape of `structure` changes incompatibly; instantiate() branches on
  // this to run old-shape migrations rather than assuming the latest shape.
  templateSchemaVersion Int                @default(1) @map("template_schema_version")
  structure             String
  createdById           Int?               @map("created_by_id")
  // Attribution only — which project this was saved from. Never read at instantiate time.
  sourceProjectId       Int?               @map("source_project_id")
  // Display-only reference text for the instantiate wizard's blanked pickers. Never applied.
  sourceCountry         String?            @map("source_country")
  sourceLocalGroup      String?            @map("source_local_group")
  sourceTeamId          Int?               @map("source_team_id")
  isArchived            Boolean            @default(false) @map("is_archived")
  createdAt             DateTime?          @default(now()) @map("created_at")
  updatedAt             DateTime?          @default(now()) @map("updated_at")

  createdBy     Volunteer? @relation("TemplateCreatedBy", fields: [createdById], references: [id], onUpdate: NoAction)
  sourceProject WorkItem?  @relation("TemplateSourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sourceTeam    Team?      @relation("TemplateSourceTeam", fields: [sourceTeamId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  instances     WorkItem[] @relation("WorkItemTemplateOrigin")

  @@index([sourceType], map: "idx_templates_source_type")
  @@index([createdById], map: "idx_templates_created_by")
  @@map("templates")
}

model LocalGroup {
  id          Int                    @id @default(autoincrement())
